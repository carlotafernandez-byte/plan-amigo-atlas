# ============================================================================
# Plan Amigo Acceso Uni — variables de entorno de la función /api/referido
# Copia este archivo a .env.local (o configúralas en Vercel) y rellena valores.
# ============================================================================

# La MISMA private-app key de HubSpot que FP/opos. Ahora LEE el comercial del
# alumno (su cierre ganado) Y CREA al colega como lead referido. SCOPES:
#   crm.objects.contacts.read    (buscar al alumno)
#   crm.objects.contacts.write   (crear el lead referido)   ← NUEVO, imprescindible
#   crm.objects.deals.read       (sacar el cierre ganado)
#   crm.objects.owners.read      (nombre/email del comercial para Slack)
# Si faltan owners.read o deals.read, el comercial NO sale en Slack aunque el
# token exista. Si falta contacts.write, no se crea el lead.
HUBSPOT_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# (Opcional) IDs de pipeline de ACCESO UNI (coma-separados) a los que dar
# prioridad para sacar el comercial del CIERRE GANADO. Por defecto ya incluye:
#   2918144211 (Acceso Uni | Ventas), 2929367239 (Portugal), 14929895 (Selectividad).
HUBSPOT_ACCESO_UNI_PIPELINE_ID=2918144211,2929367239,14929895

# (Opcional) "0" para NO asignar el lead referido al comercial del alumno.
# Por defecto, si el colega es NUEVO, se le asigna ese mismo comercial.
REFERRAL_ASSIGN_OWNER=

# --- Avisos a Slack -> canal C0BL7G1CMU6 (workspace ucademyespacio) -----------
# Elige UNA de las dos vías:
#
# A) Bot token (recomendado). App en api.slack.com/apps con scope chat:write
#    (+ users:read.email si quieres @mención real al comercial), instálala e
#    invita al bot al canal (/invite @tu-bot). El canal ya viene por defecto.
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0BL7G1CMU6
#
# B) Incoming Webhook creado apuntando a ese mismo canal (deja vacío el bot token).
SLACK_WEBHOOK_URL=
