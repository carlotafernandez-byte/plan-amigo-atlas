# ============================================================================
# Plan Amigo Acceso Uni — variables de entorno de la función /api/referido
# Copia este archivo a .env.local (o configúralas en Vercel) y rellena valores.
# ============================================================================

# --- Crear el LEAD en HubSpot (API de Formularios, SIN private app) ----------
# El colega se crea con la API de Formularios de HubSpot, igual que simulacro y
# comparador. Solo necesita el portal + el GUID de un formulario de HubSpot
# "Plan Amigo – Referidos". El formulario debe tener estos campos (= propiedades
# de contacto): email, firstname, lastname, phone, medio, canal, referrer,
# plan_amigo_atlas, como_nos_conociste_.
HUBSPOT_PORTAL_ID=25603833
HUBSPOT_FORM_GUID=                      # GUID del formulario (sin esto no se crea el lead)
PLAN_AMIGO_VALUE=Sí                     # valor que se guarda en la propiedad "Plan Amigo Atlas"

# --- Leer el COMERCIAL del cierre ganado (solo lectura) ----------------------
# Token YA existente (no hay que crear ni tocar ninguna app). Scopes de lectura:
#   crm.objects.contacts.read, crm.objects.deals.read, crm.objects.owners.read
HUBSPOT_TOKEN=pat-eu1-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# (Opcional) IDs de pipeline de ACCESO UNI (coma-separados) para priorizar el
# comercial del CIERRE GANADO. Por defecto ya incluye:
#   2918144211 (Ventas), 2929367239 (Portugal), 14929895 (Selectividad).
HUBSPOT_ACCESO_UNI_PIPELINE_ID=2918144211,2929367239,14929895

# --- Avisos a Slack -> canal C0BL7G1CMU6 (workspace ucademyespacio) -----------
# A) Bot token (recomendado). Scope chat:write (+ users:read.email para @mención).
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL_ID=C0BL7G1CMU6
# B) Incoming Webhook al mismo canal (alternativa; deja vacío el bot token).
SLACK_WEBHOOK_URL=
